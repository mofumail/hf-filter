{
  "manifest_version": 3,
  "name": "HF Model Filters",
  "version": "0.1.0",
  "description": "Extra filters for the Hugging Face models page: exact parameter range, minimum downloads/likes, recency, gated and name exclusions.",
  "content_scripts": [
    {
      "matches": ["https://huggingface.co/models*"],
      "js": ["src/lib.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hf-model-filters@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
