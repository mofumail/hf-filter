{
  "manifest_version": 3,
  "name": "HF Model Filters",
  "version": "0.1.0",
  "description": "Adds extra filters to the Hugging Face models page: an exact parameter-count range, plus minimum downloads and likes, recently updated, name exclusions and hiding gated models.",
  "homepage_url": "https://github.com/mofumail/hf-filter",
  "content_scripts": [
    {
      "matches": ["https://huggingface.co/models*"],
      "js": ["src/lib.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hf-filter@mofumail",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
